{
  "name": "@sandsoftwaresolutions/cursor-pagination",
  "version": "0.1.1",
  "description": "Opaque cursor encoding and in-memory cursor pagination for JavaScript APIs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "pagination",
    "cursor",
    "api",
    "offset",
    "infinite-scroll"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
